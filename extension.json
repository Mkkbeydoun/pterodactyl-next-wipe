{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "next-wipe",
    "name": "Next Wipe",
    "version": "1.0.0",
    "description": "Show a countdown to each server's next wipe on its console page, with an optional public page for Discord and websites.",
    "author": "RustixDev",
    "icon": "calendar-clock",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.4 <3.0",
        "php": "^8.3"
    },
    "provider": "RustixDev\\NextWipe\\NextWipeProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "rxnw",
        "screens": []
    }
}
